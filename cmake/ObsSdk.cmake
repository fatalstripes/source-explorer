# Provides OBS::libobs and OBS::obs-frontend-api from a local SDK folder instead of
# an installed/built OBS tree. Layout (see cmake/make-import-libs.ps1):
#
#   <SE_OBS_SDK_DIR>/obs-src/obs-studio-<ver>-sources/   OBS source release (headers)
#   <SE_OBS_SDK_DIR>/implibs/obs.lib, obs-frontend-api.lib  generated from installed DLLs
#   <SE_OBS_SDK_DIR>/qt6/                                 obs-deps Qt6 (CMAKE_PREFIX_PATH)
#
# Linking against import libraries made from the DLLs you actually run guarantees the
# plugin matches that OBS build's exports.

if(NOT SE_OBS_SDK_DIR)
  message(FATAL_ERROR "SE_OBS_SDK_DIR is not set")
endif()

file(GLOB _se_obs_src_candidates "${SE_OBS_SDK_DIR}/obs-src/obs-studio-*-sources")
list(LENGTH _se_obs_src_candidates _se_count)
if(_se_count EQUAL 0)
  message(FATAL_ERROR "No obs-studio-*-sources folder under ${SE_OBS_SDK_DIR}/obs-src")
endif()
list(GET _se_obs_src_candidates 0 SE_OBS_SOURCE_DIR)

foreach(_lib obs obs-frontend-api)
  if(NOT EXISTS "${SE_OBS_SDK_DIR}/implibs/${_lib}.lib")
    message(FATAL_ERROR "Missing ${SE_OBS_SDK_DIR}/implibs/${_lib}.lib - run cmake/make-import-libs.ps1")
  endif()
endforeach()

# obs-config.h includes "obsconfig.h", which OBS's own build generates. Plugins only
# need it to parse; none of these values are used by this plugin.
set(_se_gen_dir "${CMAKE_BINARY_DIR}/obs-sdk-generated")
file(MAKE_DIRECTORY "${_se_gen_dir}")
file(
  WRITE "${_se_gen_dir}/obsconfig.h"
  "#pragma once\n"
  "/* Generated by cmake/ObsSdk.cmake for building against a local SDK. */\n"
  "#define OBS_DATA_PATH \"data\"\n"
  "#define OBS_PLUGIN_PATH \"obs-plugins\"\n"
  "#define OBS_PLUGIN_DESTINATION \"obs-plugins\"\n"
  "#define OBS_RELEASE_CANDIDATE 0\n"
  "#define OBS_BETA 0\n")

add_library(OBS::libobs SHARED IMPORTED GLOBAL)
set_target_properties(
  OBS::libobs
  PROPERTIES IMPORTED_IMPLIB "${SE_OBS_SDK_DIR}/implibs/obs.lib"
             INTERFACE_INCLUDE_DIRECTORIES "${SE_OBS_SOURCE_DIR}/libobs;${_se_gen_dir}")

add_library(OBS::obs-frontend-api SHARED IMPORTED GLOBAL)
set_target_properties(
  OBS::obs-frontend-api
  PROPERTIES IMPORTED_IMPLIB "${SE_OBS_SDK_DIR}/implibs/obs-frontend-api.lib"
             INTERFACE_INCLUDE_DIRECTORIES "${SE_OBS_SOURCE_DIR}/frontend/api"
             INTERFACE_LINK_LIBRARIES OBS::libobs)

message(STATUS "Using local OBS SDK: ${SE_OBS_SOURCE_DIR}")

# Qt from the same SDK folder unless the caller already pointed elsewhere.
if(EXISTS "${SE_OBS_SDK_DIR}/qt6/lib/cmake/Qt6")
  list(PREPEND CMAKE_PREFIX_PATH "${SE_OBS_SDK_DIR}/qt6")
endif()
